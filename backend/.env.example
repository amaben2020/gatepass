PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:<password>@localhost:5432/gatepass
SESSION_SECRET=<random-32-byte-hex>
LOCALSTACK_AUTH_TOKEN=<from app.localstack.cloud>
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
JOBS_QUEUE_URL=http://localhost:4566/000000000000/gatepass-jobs
JOBS_DLQ_URL=http://localhost:4566/000000000000/gatepass-jobs-dlq
LOKI_URL=http://localhost:3100
WORKER_METRICS_PORT=9101
GATEKEEPER_METRICS_PORT=9102
PAYMENTS_QUEUE_URL=http://localhost:4566/000000000000/gatepass-payments.fifo
PAYMENTS_DLQ_URL=http://localhost:4566/000000000000/gatepass-payments-dlq.fifo
STRIPE_SECRET_KEY=<sk_test_... from dashboard.stripe.com/test/apikeys>
STRIPE_WEBHOOK_SECRET=<whsec_... printed by `stripe listen`>
