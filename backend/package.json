{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:update": "npm run db:generate && npm run db:migrate",
    "db:studio": "drizzle-kit studio",
    "worker": "SERVICE_NAME=worker tsx watch --env-file=.env src/worker.ts",
    "ls:up": "docker compose up -d localstack",
    "ls:down": "docker compose down",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "load": "k6 run load/gatepass.js",
    "workers:start": "pm2 start ecosystem.config.cjs",
    "workers:restart": "pm2 restart ecosystem.config.cjs",
    "workers:stop": "pm2 delete ecosystem.config.cjs",
    "workers:logs": "pm2 logs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1148.0",
    "connect-pg-simple": "^10.0.0",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "prom-client": "^15.1.3",
    "redis": "^6.3.0",
    "winston": "^3.19.0",
    "winston-loki": "^6.1.7"
  },
  "devDependencies": {
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
